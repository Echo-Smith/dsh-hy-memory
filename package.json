{
  "name": "@local/dsh-hy-memory",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Hy-Memory 2.0 as a native DeepSeek Harness memory component: three-tier memory (personal / project / session), three scenes (chat / working / coding), automatic recall and capture with tool traces, a Settings > Memory panel, and MemHub interoperability.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "bridge",
    "locale/*.json",
    "icon.svg",
    "docs/screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hy-memory",
    "memhub",
    "memory",
    "agent-memory",
    "long-term-memory",
    "personalization",
    "context",
    "plugin",
    "three-tier-memory"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Echo-Smith/hy-memory4dsh.git"
  },
  "homepage": "https://github.com/Echo-Smith/hy-memory4dsh#readme",
  "bugs": {
    "url": "https://github.com/Echo-Smith/hy-memory4dsh/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/panel-smoke.mjs",
    "eval:recall": "node scripts/eval-recall.mjs",
    "check": "node --check index.js && node --check src/panel-api.js && node --check src/capture.js && node --check client.js",
    "eval:live": "node scripts/eval-live.mjs",
    "migrate:embeddings": "node scripts/migrate-embeddings.mjs",
    "bench:startup": "node scripts/bench-startup.mjs",
    "pack:publish": "node scripts/prepare-publish.mjs",
    "install:profile": "node scripts/install-into-profile.mjs",
    "validate:market": "node scripts/validate-market-index.mjs"
  }
}
